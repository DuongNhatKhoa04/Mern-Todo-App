# File env này nằm ở /home/secrets/.env trên EC2 (source repo ở /home/Mern-Todo-App).
# Nó đóng 2 vai: (1) --env-file để compose interpolate, (2) env_file nạp vào BE.
BACKEND_ENV_FILE=/home/secrets/.env

# RELEASE_TAG: CI/CD tự export khi deploy nên ở đây là THỪA với luồng tự động.
# Giữ lại làm fallback cho lệnh `docker compose ... up/ps` chạy tay (không prefix).
RELEASE_TAG=production

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_DATABASE=todo

# PORT=8000 BẮT BUỘC: default trong backend/server.js là 8001. Bỏ đi thì BE nghe
# 8001, lệch với port map 127.0.0.1:8000:8000 và healthcheck :8000 → fail.
PORT=8000
MONGO_URI=mongodb://admin:CHANGE_ME@mongo:27017/todo?authSource=admin
JWT_SECRET=CHANGE_ME

APP_BASE_URL=https://nhatkhoa.name.vn
GMAIL_USERNAME=your-account@gmail.com
GMAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM=your-account@gmail.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Jenkins: không cần biến admin — setup qua wizard lần đầu
# (docker exec jenkins cat /var/jenkins_home/secrets/initialAdminPassword)
